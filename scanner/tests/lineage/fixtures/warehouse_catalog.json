      ]
    },
    {
      "database": "warehouse",
      "schema": "raw",
      "name": "sessions",
      "type": "table",
      "row_count": 2000000,
      "owner": "etl_service",
      "columns": [
        {"name": "id", "type": "bigint", "nullable": false},
        {"name": "user_id", "type": "integer", "nullable": true},
        {"name": "started_at", "type": "timestamp", "nullable": false},
        {"name": "ended_at", "type": "timestamp", "nullable": true},
        {"name": "device", "type": "varchar(100)", "nullable": true}
      ]
    },
    {
      "database": "warehouse",
      "schema": "analytics",
      "name": "user_activity_summary",
      "type": "view",
      "view_definition": "SELECT c.customer_id, c.customer_name, COUNT(DISTINCT e.id) AS event_count, COUNT(DISTINCT s.id) AS session_count FROM analytics.dim_customers c LEFT JOIN raw.events e ON c.customer_id = e.user_id LEFT JOIN raw.sessions s ON c.customer_id = s.user_id GROUP BY 1, 2",
      "columns": [
        {"name": "customer_id", "type": "integer", "nullable": false},
        {"name": "customer_name", "type": "varchar(255)", "nullable": false},
        {"name": "event_count", "type": "bigint", "nullable": true},
        {"name": "session_count", "type": "bigint", "nullable": true}
      ]
    },
    {
      "database": "warehouse",
      "schema": "analytics",
      "name": "order_funnel",
      "type": "view",
      "view_definition": "SELECT c.country, COUNT(DISTINCT c.customer_id) AS customers, COUNT(DISTINCT o.order_id) AS orders, SUM(o.order_amount) AS revenue FROM analytics.dim_customers c LEFT JOIN analytics.fct_orders o ON c.customer_id = o.customer_id GROUP BY 1",
      "columns": [
        {"name": "country", "type": "varchar(100)", "nullable": true},
        {"name": "customers", "type": "bigint", "nullable": true},
        {"name": "orders", "type": "bigint", "nullable": true},
        {"name": "revenue", "type": "numeric(14,2)", "nullable": true}
      ]
    },
