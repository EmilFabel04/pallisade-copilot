    {
      "database": "warehouse",
      "schema": "reporting",
      "name": "rpt_daily_sales",
      "type": "view",
      "view_definition": "SELECT o.ordered_at::date AS sale_date, COUNT(o.order_id) AS num_orders, SUM(o.order_amount) AS total_amount FROM analytics.fct_orders o GROUP BY 1",
      "columns": [
        {"name": "sale_date", "type": "date", "nullable": false},
        {"name": "num_orders", "type": "integer", "nullable": false},
        {"name": "total_amount", "type": "numeric(14,2)", "nullable": false}
      ]
    },
    {
      "database": "warehouse",
      "schema": "reporting",
      "name": "rpt_top_products",
      "type": "view",
      "view_definition": "SELECT p.product_id, p.product_name, p.category, p.total_sold, p.price * p.total_sold AS total_revenue FROM analytics.dim_products p WHERE p.total_sold > 0 ORDER BY total_revenue DESC",
      "columns": [
        {"name": "product_id", "type": "integer", "nullable": false},
        {"name": "product_name", "type": "varchar(255)", "nullable": false},
        {"name": "category", "type": "varchar(100)", "nullable": true},
        {"name": "total_sold", "type": "integer", "nullable": false},
        {"name": "total_revenue", "type": "numeric(14,2)", "nullable": false}
      ]
    },
    {
