    {
      "name": "dim_customers",
      "database": "warehouse",
      "schema": "analytics",
      "materialized": "table",
      "depends_on": ["stg_customers", "stg_orders"],
      "columns": [
        {"name": "customer_id", "type": "integer"},
        {"name": "customer_name", "type": "varchar"},
        {"name": "email", "type": "varchar"},
        {"name": "signup_date", "type": "timestamp"},
        {"name": "country", "type": "varchar"},
        {"name": "total_orders", "type": "integer"},
        {"name": "first_order_date", "type": "timestamp"}
      ],
      "compiled_sql": "SELECT c.customer_id, c.customer_name, c.email, c.signup_date, c.country, COUNT(o.order_id) AS total_orders, MIN(o.ordered_at) AS first_order_date FROM staging.stg_customers c LEFT JOIN staging.stg_orders o ON c.customer_id = o.customer_id GROUP BY 1,2,3,4,5",
      "description": "Customer dimension with order stats",
      "owner": "analytics-team",
      "tags": ["tier1", "dimension"]
    },
    {
      "name": "fct_orders",
      "database": "warehouse",
      "schema": "analytics",
      "materialized": "table",
      "depends_on": ["stg_orders", "stg_payments", "stg_order_items"],
      "columns": [
        {"name": "order_id", "type": "integer"},
        {"name": "customer_id", "type": "integer"},
        {"name": "order_amount", "type": "numeric"},
        {"name": "payment_amount", "type": "numeric"},
        {"name": "item_count", "type": "integer"},
        {"name": "ordered_at", "type": "timestamp"}
      ],
      "compiled_sql": "SELECT o.order_id, o.customer_id, o.order_amount, COALESCE(p.payment_amount, 0) AS payment_amount, COALESCE(i.item_count, 0) AS item_count, o.ordered_at FROM staging.stg_orders o LEFT JOIN staging.stg_payments p ON o.order_id = p.order_id LEFT JOIN (SELECT order_id, COUNT(*) AS item_count FROM staging.stg_order_items GROUP BY 1) i ON o.order_id = i.order_id",
      "description": "Fact table for orders with payment and item info",
      "owner": "analytics-team",
      "tags": ["tier1", "fact"]
    },
