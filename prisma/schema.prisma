enum CopilotContextType {
  GENERAL       // General Q&A about the data stack
  PIPELINE      // Focused on a specific pipeline
  DEBUGGING     // Active debugging session
  BUILDING      // Building/configuring pipeline
}

// ============================================
// OPENLINEAGE EVENT STORAGE
// ============================================

model LineageEvent {
  id              String   @id @default(cuid())
  
  // Event metadata
  eventType       String   // START, RUNNING, COMPLETE, FAIL, ABORT
  eventTime       DateTime
  
  // Job identification
  jobNamespace    String
  jobName         String
  
  // Run identification
  runId           String
  parentRunId     String?
  
  // Input/output datasets (JSON arrays)
  inputs          Json     // Array of input datasets
  outputs         Json     // Array of output datasets
  
  // Facets (additional metadata)
  jobFacets       Json?
  runFacets       Json?
  
  // Processing status
  processed       Boolean  @default(false)
  processedAt     DateTime?
  
  createdAt       DateTime @default(now())
  
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String

  @@index([organizationId])
  @@index([jobNamespace, jobName])
  @@index([runId])
  @@index([eventTime])
  @@index([processed])
}

// ============================================
// DEBUG SESSION TRACKING
// ============================================

model DebugSession {
  id              String   @id @default(cuid())
  
  // Issue identification
  issueType       String   // sync_failure, test_failed, stale_data, query_error, etc.
  title           String
  description     String?  @db.Text
  
  // Symptom tracking (where the issue was first observed)
  symptomNodeId   String?
  symptomDetails  Json?
  
  // Root cause analysis
  rootCauseNodeId String?
  rootCauseType   String?
  rootCauseDetails Json?
  
  // Status and resolution
  status          DebugStatus @default(INVESTIGATING)
  resolution      String?     @db.Text
  resolvedAt      DateTime?
  
  // Timing
  startedAt       DateTime @default(now())
  mttr            Int?     // Mean time to resolution in minutes
  
  // Investigation steps taken
  investigationSteps Json? // Array of steps/findings during investigation
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  copilotSession  CopilotSession? @relation(fields: [copilotSessionId], references: [id])
  copilotSessionId String? @unique

  @@index([organizationId])
  @@index([status])
  @@index([issueType])
}

enum DebugStatus {
  INVESTIGATING    // Still looking into the issue
  ROOT_CAUSE_FOUND // Identified the root cause
  FIXING           // Working on a fix
  RESOLVED         // Issue resolved
  WONT_FIX         // Decided not to fix
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([read])
}

enum NotificationType {
  REPORT_READY
  TASK_DUE
  PLAN_UPDATE
  SECURITY_ALERT
  SYSTEM
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id String @id @default(cuid())

  // What happened
  action      String // 'scan.started', 'integration.created', 'user.login', etc.
  category    String // 'scan', 'integration', 'user', 'schedule', 'settings'
  description String // Human-readable description

  // Who did it
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  userEmail String? // Denormalized for display
  userName  String? // Denormalized for display

  // Context
  resourceType String? // 'Report', 'Integration', 'Schedule', etc.
  resourceId   String? // ID of the affected resource
  resourceName String? // Name of the affected resource

  // Details
  metadata  Json? // Additional context (old/new values, etc.)
  ipAddress String? // Request IP
  userAgent String? // Browser/client info

  // Status
  status       String  @default("success") // 'success', 'failure', 'pending'
  errorMessage String? // If status is failure

  // Timestamp
  createdAt DateTime @default(now())

  // Organization scope
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

// ============================================
// APPLIED FIXES (One-Click Fix Tracking)
// ============================================

model AppliedFix {
  id String @id @default(cuid())

  // What fix was applied
  fixType  String // 'dbt_freshness', 'dbt_null_test', 'sql_script', etc.
  fixTitle String
  fixCode  String @db.Text
  language String // 'yaml', 'sql', 'python'

  // Where it was applied
  repoOwner  String // GitHub owner/org
  repoName   String // Repository name
  filePath   String // Path in repo where fix was applied
  branchName String // Branch created for the fix
  writeMode  String // 'create', 'append', 'replace'

  // GitHub references
  commitSha String? // Commit SHA
  prNumber  Int? // Pull Request number
  prUrl     String? // Full PR URL
  prStatus  String  @default("open") // 'open', 'merged', 'closed'

  // Link to the original finding
  reportId     String?
  findingId    String? // ID within the report's findings array
  findingTitle String?
  table        String? // Affected table (if applicable)
  column       String? // Affected column (if applicable)

  // Issue context for learning
  issueType     String? // 'freshness', 'null_spike', 'volume_drop'
  issueCategory String? // 'data_quality', 'pipeline', 'security'
  severity      String? // 'critical', 'high', 'medium', 'low'

  // Metrics at time of fix (for before/after comparison)
  metricSnapshot Json? // { "null_rate": 0.35, "freshness_hours": 48 }

  // Fix generation context
  confidenceScore Float? // AI confidence when generating fix
  generationMethod String? // 'template', 'rag', 'learned'

  // Status tracking
  status       AppliedFixStatus @default(PENDING)
  appliedAt    DateTime         @default(now())
  mergedAt     DateTime?
  errorMessage String?

  // Who applied it
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Organization
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  // Outcome tracking (one-to-one)
  outcome FixOutcome?

  @@index([organizationId])
  @@index([userId])
  @@index([reportId])
  @@index([prStatus])
  @@index([status])
  @@index([issueType])
  @@index([table])
}

enum AppliedFixStatus {
  PENDING // PR created, awaiting merge
  MERGED // PR merged successfully
  CLOSED // PR closed without merge
  FAILED // Failed to create PR
}

// ============================================
// FIX OUTCOME TRACKING (Learning Loop)
// ============================================

// Tracks whether applied fixes actually resolved issues
model FixOutcome {
  id String @id @default(cuid())

  // Link to the applied fix
  appliedFix   AppliedFix @relation(fields: [appliedFixId], references: [id], onDelete: Cascade)
  appliedFixId String     @unique

  // === OUTCOME STATUS ===
  outcome FixOutcomeStatus @default(PENDING)

  // Detection method
  detectionMethod OutcomeDetectionMethod @default(AUTOMATIC)

  // === TIMING ===
  detectedAt       DateTime? // When outcome was determined
  timeToResolution Int? // Minutes from fix applied to issue resolved

  // === METRICS COMPARISON ===
  metricsBefore Json? // Snapshot of metrics before fix
  metricsAfter  Json? // Snapshot of metrics after fix
  // Example: { "null_rate": 0.35, "freshness_hours": 48, "row_count": 1000 }

  improvement Float? // Percentage improvement (-1.0 to 1.0)
  // -0.5 = 50% worse, 0 = no change, 0.5 = 50% better, 1.0 = fully fixed

  // === USER FEEDBACK ===
  userRating      Int? // 1-5 stars
  userFeedback    String? @db.Text
  feedbackGivenAt DateTime?
  feedbackUserId  String?

  // === ISSUE CONTEXT (for similarity matching) ===
  issueFingerprint   IssueFingerprint? @relation(fields: [issueFingerprintId], references: [id])
  issueFingerprintId String?

  // === TRACKING ===
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization
  organizationId String?

  @@index([outcome])
  @@index([organizationId])
  @@index([detectedAt])
  @@index([issueFingerprintId])
}

enum FixOutcomeStatus {
  PENDING // Waiting to determine if fix worked
  RESOLVED // Issue was fixed
  PARTIALLY_RESOLVED // Issue improved but not fully fixed
  UNRESOLVED // Issue persists
  REGRESSED // Issue got worse
  UNKNOWN // Couldn't determine (e.g., table deleted)
}

enum OutcomeDetectionMethod {
  AUTOMATIC // Detected by subsequent scan
  USER_CONFIRMED // User marked as resolved
  PR_MERGED // PR was merged (assumed working)
  TIMEOUT // No reoccurrence after X days
}

// Fingerprint for matching similar issues
model IssueFingerprint {
  id String @id @default(cuid())

  // === ISSUE IDENTITY ===
  issueType     String // 'freshness', 'null_spike', 'volume_drop', 'schema_change', etc.
  issueCategory String // 'data_quality', 'pipeline', 'security'
  severity      String // 'critical', 'high', 'medium', 'low'

  // === CONTEXT ===
  tablePattern  String? // Pattern like 'stg_*', 'dim_*', '*_events'
  columnPattern String? // Pattern like '*_id', '*_at', 'email'
  warehouseType String? // 'snowflake', 'bigquery', 'postgres'

  // === STACK CONTEXT ===
  hasDBT      Boolean @default(false)
  hasAirflow  Boolean @default(false)
  hasPrefect  Boolean @default(false)
  hasFivetran Boolean @default(false)

  // === ISSUE SPECIFICS ===
  // Normalized values for similarity matching
  thresholdExceededBy Float? // How much the threshold was exceeded (ratio)
  // e.g., SLO is 4h, actual is 48h → 12.0

  // Contextual clues
  dayOfWeek     Int? // 0=Sunday, 6=Saturday
  hourOfDay     Int? // 0-23
  isWeekend     Boolean?
  isMonthEnd    Boolean?
  isQuarterEnd  Boolean?

  // === EMBEDDING (for ML similarity) ===
  embedding     Bytes? // Vector embedding for similarity search
  embeddingModel String? // Model used to generate embedding

  // === STATISTICS ===
  occurrenceCount Int      @default(1) // How many times this pattern occurred
  lastSeenAt      DateTime @default(now())
  firstSeenAt     DateTime @default(now())

  // === RELATIONS ===
  outcomes       FixOutcome[]
  fixPatterns    FixPatternMatch[]

  // Organization
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueType])
  @@index([issueCategory])
  @@index([organizationId])
  @@index([warehouseType])
  @@unique([organizationId, issueType, tablePattern, columnPattern, warehouseType])
}

// Learned patterns: which fixes work for which issue types
model FixPattern {
  id String @id @default(cuid())

  // === PATTERN IDENTITY ===
  name        String // Human-readable name
  description String? @db.Text

  // === APPLICABILITY ===
  issueType     String // 'freshness', 'null_spike', etc.
  issueCategory String // 'data_quality', 'pipeline'

  // Stack requirements
  requiredStack     Json? // { "dbt": true, "warehouse": "snowflake" }
  requiredContext   Json? // { "has_timestamp_column": true }

  // === FIX TEMPLATE ===
  fixType       String // 'dbt_freshness', 'sql_update', 'airflow_dag'
  fixTemplate   String @db.Text // Template with placeholders
  fixLanguage   String // 'yaml', 'sql', 'python'
  fixFilePath   String? // Default file path

  // Placeholders this template uses
  placeholders Json? // ["{{table}}", "{{column}}", "{{threshold}}"]

  // === EFFECTIVENESS ===
  successCount Int   @default(0)
  failureCount Int   @default(0)
  successRate  Float @default(0) // Calculated: success / (success + failure)

  totalApplications Int @default(0)
  avgTimeToResolve  Int? // Average minutes to resolution

  // Confidence based on data
  confidenceScore Float @default(0.5) // 0.0 - 1.0
  // Starts at 0.5, increases with successes, decreases with failures

  // === METADATA ===
  isBuiltIn  Boolean @default(false) // System-provided vs learned
  isApproved Boolean @default(true) // Admin approved for auto-apply

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === RELATIONS ===
  matches FixPatternMatch[]

  // Organization (null = global pattern)
  organizationId String?

  @@index([issueType])
  @@index([successRate])
  @@index([organizationId])
}

// Links fingerprints to patterns (many-to-many with metadata)
model FixPatternMatch {
  id String @id @default(cuid())

  fingerprint   IssueFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  fingerprintId String

  pattern   FixPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  patternId String

  // Match quality
  matchScore Float @default(1.0) // How well this pattern fits (0.0 - 1.0)

  // Usage stats for this specific match
  usageCount    Int   @default(0)
  successCount  Int   @default(0)
  localSuccessRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fingerprintId, patternId])
  @@index([patternId])
  @@index([fingerprintId])
}

// ============================================
// N8N INTEGRATIONS
// ============================================

model Integration {
  id     String            @id @default(cuid())
  name   String // Display name (e.g., "Production Snowflake")
  type   IntegrationType
  status IntegrationStatus @default(INACTIVE)

  // Credentials (encrypted at rest)
  credentials Json? // Encrypted connection credentials

  // OAuth tokens (for GitHub, Slack, etc.)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  // Config & metadata
  config   Json? // Type-specific config (e.g., database names, repos)
  metadata Json? // Discovered metadata (tables, jobs, etc.)

  // Connection info (for display)
  connectionInfo String? // Human-readable connection summary

  // Health tracking
  lastSyncAt  DateTime?
  lastTestAt  DateTime?
  lastError   String?
  healthScore Int? // 0-100 based on recent scans

  // Scan tracking
  scanCount  Int       @default(0)
  lastScanAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id])
  organizationId   String
  tableConfigs     TableConfig[]
  dataContracts    DataContract[]
  lineageNodes     LineageNode[]
  lineageSnapshots LineageSnapshot[]
  metricBaselines  MetricBaseline[]
  scanSchedules    ScanSchedule[]
  findings         Finding[]
  
  // Pipeline nodes that use this integration
  pipelineNodes    PipelineNode[]
  
  // User feedback on ML suppressions for this integration
  suppressionOverrides SuppressionOverride[]

  @@unique([organizationId, type, name]) // Prevent duplicate connections
  @@index([organizationId])
  @@index([type])
  @@index([status])
}

enum IntegrationType {
  // ===========================================
  // WAREHOUSE (Layer: WAREHOUSE)
  // ===========================================
  SNOWFLAKE         // Primary cloud data warehouse
  BIGQUERY          // Google Cloud data warehouse
  POSTGRES          // PostgreSQL (also covers Supabase, RDS, etc.)
  REDSHIFT          // AWS data warehouse
  SQLSERVER         // On-premise SQL Server
  AZURE_SQL         // Azure SQL Database
  AZURE_SYNAPSE     // Azure Synapse Analytics
  
  // ===========================================
  // INGESTION (Layer: INGESTION)
  // ===========================================
  FIVETRAN          // Managed ETL/ELT
  AIRBYTE           // Open-source ELT
  STITCH            // Singer-based ETL
  
  // ===========================================
  // TRANSFORMATION (Layer: TRANSFORMATION)
  // ===========================================
  DBT_CLOUD         // dbt Cloud (hosted)
  DBT_CORE          // dbt Core (self-hosted/manifest upload)
  AIRFLOW           // Apache Airflow orchestration
  DAGSTER           // Dagster orchestration
  PREFECT           // Prefect orchestration
  
  // ===========================================
  // REPORTING (Layer: REPORTING)
  // ===========================================
  TABLEAU           // Tableau dashboards
  LOOKER            // Looker / Looker Studio
  POWERBI           // Microsoft Power BI
  METABASE          // Open-source BI
  
  // ===========================================
  // CODE & VERSION CONTROL
  // ===========================================
  GITHUB            // For fix PRs
  GITLAB
  BITBUCKET
  
  // ===========================================
  // NOTIFICATIONS
  // ===========================================
  SLACK
  PAGERDUTY
  OPSGENIE
  TEAMS             // Microsoft Teams
  
  // ===========================================
  // OTHER
  // ===========================================
  JIRA              // Issue tracking
  CUSTOM_WEBHOOK    // Generic webhook
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// ============================================
// N8N WORKFLOW TRACKING
// ============================================

model WorkflowRun {
  id           String         @id @default(cuid())
  workflowId   String // orchestration workflow ID
  workflowName String
  status       WorkflowStatus @default(PENDING)

  // Input/Output
  inputData    Json?
  outputData   Json?
  errorMessage String?

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Links
  reportId String? // If workflow generated a report
  userId   String?

  @@index([workflowId])
  @@index([status])
  @@index([userId])
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// ML METRIC BASELINES (Persistent Learning)
// ============================================

model MetricBaseline {
  id String @id @default(cuid())

  // Metric identification
  metricKey  String // Unique key: "table.column.metric_type" e.g., "ORDERS.AMOUNT.null_rate"
  tableName  String // Full table name
  columnName String? // Optional column (null for table-level metrics)
  metricType MetricType

  // Learned statistics
  mean     Float
  stdDev   Float
  median   Float
  minValue Float?
  maxValue Float?

  // Quartiles for IQR
  percentile25 Float?
  percentile50 Float?
  percentile75 Float?
  percentile90 Float?
  percentile99 Float?

  // Time patterns (JSON for hourly/daily patterns)
  hourlyPatterns Json? // { "0": 100, "1": 95, ..., "23": 110 }
  dailyPatterns  Json? // { "0": 100, "1": 105, ..., "6": 80 } (0=Mon, 6=Sun)

  // Trend
  trendDirection String @default("stable") // increasing, decreasing, stable
  trendSlope     Float  @default(0)

  // Learning metadata
  sampleCount    Int       @default(0)
  windowDays     Int       @default(30)
  lastValue      Float?
  lastObservedAt DateTime?

  // Configuration
  sensitivity Float   @default(0.5) // 0.0-1.0, higher = more sensitive
  enabled     Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?

  // Historical observations (last N points)
  observations MetricObservation[]

  @@unique([organizationId, metricKey])
  @@index([organizationId])
  @@index([integrationId])
  @@index([tableName])
  @@index([metricType])
}

model MetricObservation {
  id String @id @default(cuid())

  // Value
  value     Float
  timestamp DateTime @default(now())

  // Context
  hourOfDay Int? // 0-23
  dayOfWeek Int? // 0-6 (Mon-Sun)

  // Anomaly detection result (if flagged)
  isAnomaly       Boolean @default(false)
  anomalyScore    Float?
  anomalySeverity String? // critical, high, medium, low

  // Relation
  baseline   MetricBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  baselineId String

  @@index([baselineId])
  @@index([timestamp])
}

enum MetricType {
  // Column-level metrics
  NULL_RATE
  DISTINCT_COUNT
  DISTINCT_RATE
  MIN_VALUE
  MAX_VALUE
  AVG_VALUE
  SUM_VALUE
  STDDEV

  // Table-level metrics
  ROW_COUNT
  FRESHNESS_HOURS
  SIZE_BYTES

  // Quality metrics
  DUPLICATE_RATE
  EMPTY_STRING_RATE
  OUTLIER_COUNT

  // Custom
  CUSTOM
}

// ============================================
// RISK INTELLIGENCE & DATA COLLECTION
// (For Insurance API Business)
// ============================================

// Comprehensive snapshot of each scan for historical analysis
model ScanSnapshot {
  id String @id @default(cuid())

  // Organization context (anonymized for benchmarking)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Scan metadata
  scanType       String // freshness, quality, schema, secrets, volume
  scanTimestamp  DateTime @default(now())
  scanDurationMs Int? // How long the scan took

  // Results summary
  overallScore  Int // 0-100
  tablesScanned Int
  findingsCount Int
  criticalCount Int
  highCount     Int
  mediumCount   Int
  lowCount      Int

  // Auto-fix metrics
  autoFixAvailable Int @default(0)
  autoFixApplied   Int @default(0)

  // Detailed metrics (for trend analysis)
  avgFreshnessHours Float?
  avgNullRate       Float?
  avgDuplicateRate  Float?
  schemaChanges     Int?
  secretsExposed    Int?
  piiTablesFound    Int?

  // Coverage metrics
  coveragePercent Float? // % of tables monitored vs total
  testCoverage    Float? // % of tables with dbt tests

  // Response metrics
  incidentsCreated Int  @default(0)
  mttr             Int? // Minutes to resolve (if incidents closed)

  // Industry classification (for benchmarking)
  industry    String? // fintech, saas, ecommerce, healthcare, etc.
  companySize String? // startup, smb, mid-market, enterprise

  // Raw data (encrypted, for detailed analysis)
  findingsJson Json? // Anonymized findings
  metricsJson  Json? // Detailed metrics by table

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([scanType])
  @@index([scanTimestamp])
  @@index([industry])
}

// Aggregated risk profile per organization (updated daily)
model OrganizationRiskProfile {
  id String @id @default(cuid())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  // Overall risk scores (0-100, higher = more risk)
  overallRiskScore    Int @default(50)
  dataQualityRisk     Int @default(50)
  dataFreshnessRisk   Int @default(50)
  schemaStabilityRisk Int @default(50)
  securityRisk        Int @default(50)
  operationalRisk     Int @default(50) // Based on MTTR, coverage

  // Trend indicators
  riskTrend        String @default("stable") // improving, degrading, stable
  riskTrendPercent Float  @default(0) // % change over 30 days

  // Key metrics
  avgDrrScore       Float @default(0) // Average Data Reliability Rating
  avgMttr           Int   @default(0) // Minutes
  avgMttd           Int   @default(0) // Mean time to detect (minutes)
  incidentFrequency Float @default(0) // Incidents per week
  coveragePercent   Float @default(0) // % of tables monitored

  // Volume metrics
  totalTables     Int @default(0)
  monitoredTables Int @default(0)
  totalScansRun   Int @default(0)
  scansLast30Days Int @default(0)

  // Quality metrics (averages)
  avgNullRate           Float?
  avgDuplicateRate      Float?
  avgFreshnessHours     Float?
  schemaChangeFrequency Float? // Changes per week

  // Security metrics
  secretsExposedEver Int    @default(0)
  piiTablesCount     Int    @default(0)
  encryptionCoverage Float? // % of PII tables encrypted

  // Classification
  industry          String?
  companySize       String?
  dataMaturityLevel String  @default("emerging") // emerging, developing, mature, advanced

  // Computed at
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([industry])
  @@index([overallRiskScore])
  @@index([dataMaturityLevel])
}

// Industry benchmarks (aggregated across all customers)
model IndustryBenchmark {
  id String @id @default(cuid())

  // Benchmark identifier
  industry    String // fintech, saas, ecommerce, healthcare, etc.
  companySize String? // startup, smb, mid-market, enterprise (null = all sizes)
  period      String // 2024-Q1, 2024-01, etc.

  // Sample size
  organizationCount Int @default(0)
  scanCount         Int @default(0)

  // Benchmark scores (percentiles)
  drrScore_p25 Float?
  drrScore_p50 Float?
  drrScore_p75 Float?
  drrScore_p90 Float?

  // Risk scores
  avgRiskScore  Float?
  riskScore_p25 Float?
  riskScore_p50 Float?
  riskScore_p75 Float?

  // Operational metrics
  avgMttr  Int? // Minutes
  mttr_p25 Int?
  mttr_p50 Int?
  mttr_p75 Int?

  avgCoverage  Float?
  coverage_p50 Float?

  // Quality metrics
  avgNullRate       Float?
  avgFreshnessHours Float?
  avgIncidentRate   Float? // Per week

  // Calculated at
  calculatedAt DateTime @default(now())

  @@unique([industry, companySize, period])
  @@index([industry])
  @@index([period])
}

// ============================================
// RISK API (For Insurance Partners)
// ============================================

// Insurance partners who subscribe to the Risk API
model RiskAPISubscription {
  id String @id @default(cuid())

  // Partner info
  partnerName  String
  partnerType  String // cyber_insurer, data_insurer, tech_eo, broker
  contactEmail String
  contactName  String?

  // API credentials
  apiKey     String @unique
  apiKeyHash String // Hashed version for verification

  // Subscription details
  plan   RiskAPIPlan   @default(STANDARD)
  status RiskAPIStatus @default(ACTIVE)

  // Rate limits
  requestsPerMonth Int      @default(1000)
  requestsUsed     Int      @default(0)
  requestsResetAt  DateTime @default(now())

  // Pricing
  monthlyFee    Float? // Custom pricing
  perRequestFee Float? // Pay-per-request pricing

  // Access control
  allowedEndpoints  String[] @default([]) // Which endpoints they can access
  allowedIndustries String[] @default([]) // Which industries they can query

  // Audit
  lastRequestAt     DateTime?
  totalRequestsEver Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  requests RiskAPIRequest[]

  @@index([apiKey])
  @@index([partnerType])
}

// Log of all Risk API requests (for billing and audit)
model RiskAPIRequest {
  id String @id @default(cuid())

  // Subscription
  subscription   RiskAPISubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String

  // Request details
  endpoint      String // /risk/score, /risk/benchmark, /risk/report
  method        String // GET, POST
  requestParams Json? // Query params or body (anonymized)

  // Response
  responseStatus Int // HTTP status code
  responseTimeMs Int? // Response time

  // Billing
  billable     Boolean @default(true)
  billedAmount Float?

  // Client info
  clientIp  String?
  userAgent String?

  timestamp DateTime @default(now())

  @@index([subscriptionId])
  @@index([timestamp])
  @@index([endpoint])
}

enum RiskAPIPlan {
  STARTER // 100 requests/month, basic endpoints
  STANDARD // 1,000 requests/month, all endpoints
  PROFESSIONAL // 10,000 requests/month, all + bulk
  ENTERPRISE // Unlimited, custom
}

enum RiskAPIStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

// ============================================
// FINDING RESPONSE SYSTEM
// ============================================

// Individual scan finding that can be tracked and responded to
model Finding {
  id String @id @default(cuid())

  // Finding identification (unique per scan context)
  fingerprint String // Hash of table+column+type+description for deduplication
  
  // Finding details
  table       String
  column      String?
  scanType    String // freshness, quality, volume, schema, anomaly, distribution, integrity
  findingType String // null_rate, negative_value, duplicate, orphan, stale, etc.
  severity    FindingSeverity
  
  // Finding content
  title       String
  description String @db.Text
  details     Json?  // Additional context (sample values, counts, etc.)
  
  // Fix information
  suggestedFix     String? @db.Text
  fixType          String? // sql, dbt_test, pipeline_config, manual
  fixConfidence    Float?  // 0-1 confidence in the suggested fix
  
  // State
  status      FindingStatus @default(OPEN)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  resolvedAt  DateTime?
  
  // Scan context
  scanCount   Int @default(1) // How many times this was detected
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?
  report         Report?      @relation(fields: [reportId], references: [id])
  reportId       String?
  
  // Response tracking
  responses FindingResponse[]
  
  // Rule that might apply
  matchedRule   FindingRule? @relation(fields: [matchedRuleId], references: [id])
  matchedRuleId String?

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([integrationId])
  @@index([status])
  @@index([severity])
  @@index([scanType])
  @@index([fingerprint])
}

// User response to a finding
model FindingResponse {
  id String @id @default(cuid())

  // Response type
  responseType ResponseType
  
  // Justification (required for some response types)
  reason       String?  @db.Text
  justification String? @db.Text // Detailed explanation
  
  // For ACCEPTED_RISK: who approved it
  approvedBy   String?
  approvedAt   DateTime?
  
  // Expiration (for temporary suppressions)
  expiresAt    DateTime?
  
  // Was this reviewed/verified?
  verified     Boolean @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String
  
  // Who responded
  userId    String?
  userName  String? // Denormalized for audit

  @@index([findingId])
  @@index([responseType])
  @@index([createdAt])
}

// Smart rules for expected patterns (replaces per-finding suppressions)
model FindingRule {
  id String @id @default(cuid())

  // Rule identification
  name        String
  description String? @db.Text
  
  // Rule conditions (all must match)
  conditions  Json // { table: "pattern", column: "pattern", findingType: "x", ... }
  
  // What happens when matched
  action      RuleAction @default(REDUCE_SEVERITY)
  
  // For REDUCE_SEVERITY
  targetSeverity FindingSeverity?
  
  // For SUPPRESS
  suppressReason String?
  
  // Rule metadata
  isActive    Boolean @default(true)
  priority    Int     @default(0) // Higher = checked first
  
  // Audit
  createdBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  
  // Expiration
  expiresAt   DateTime?
  
  // Stats
  matchCount  Int @default(0)
  lastMatchAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  // Findings matched by this rule
  matchedFindings Finding[]

  @@index([organizationId])
  @@index([isActive])
}

// User feedback on ML/baseline suppression decisions
// Allows users to approve or deny automatic suppressions
model SuppressionOverride {
  id String @id @default(cuid())

  // What is being overridden
  table         String        // Table name (e.g., "analytics.daily_revenue")
  column        String?       // Column name (optional, for table-wide overrides)
  findingType   String?       // Type of finding (e.g., "outlier", "duplicate")
  
  // The suppression source being overridden
  suppressionSource String    // semantic_classification, correlation, baseline
  
  // User's decision
  decision      OverrideDecision
  reason        String?       @db.Text // User's explanation
  
  // Original classification info (for context)
  originalClassification Json? // The original LLM/baseline classification
  
  // Audit trail
  createdBy     String?       // User ID
  createdByName String?       // User name (denormalized)
  approvedBy    String?       // For requiring approval on denials
  approvedAt    DateTime?
  
  // Expiration (optional - allow temporary overrides)
  expiresAt     DateTime?
  
  // Stats
  appliedCount  Int @default(0) // How many times this override was applied
  lastAppliedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?

  @@unique([organizationId, table, column, findingType, suppressionSource])
  @@index([organizationId])
  @@index([table])
  @@index([integrationId])
}

enum OverrideDecision {
  APPROVE   // User confirms suppression is correct
  DENY      // User says this should be an alert
}

// DRR Score tracking over time
model DRRScore {
  id String @id @default(cuid())

  // Score components
  totalFindings     Int
  resolvedFindings  Int // Actually fixed
  acknowledgedCount Int // Acknowledged but not fixed
  falsePositives    Int // Verified false positives (excluded from calculation)
  acceptedRisks     Int // Stakeholder-approved risks (tracked separately)
  suppressedCount   Int // Suppressed by rules (tracked separately)
  
  // The actual DRR score (resolved / (total - falsePositives))
  drrScore          Float
  
  // Breakdown by severity
  criticalTotal     Int @default(0)
  criticalResolved  Int @default(0)
  highTotal         Int @default(0)
  highResolved      Int @default(0)
  mediumTotal       Int @default(0)
  mediumResolved    Int @default(0)
  lowTotal          Int @default(0)
  lowResolved       Int @default(0)
  
  // Context
  scanType          String? // null = overall, or specific scan type
  
  // Timestamp
  recordedAt DateTime @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  report         Report?      @relation(fields: [reportId], references: [id])
  reportId       String?

  @@index([organizationId])
  @@index([recordedAt])
  @@index([scanType])
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN          // New/unaddressed
  IN_PROGRESS   // Being worked on
  RESOLVED      // Fixed and verified
  WONT_FIX      // Acknowledged, won't be fixed
  FALSE_POSITIVE // Not a real issue
  ACCEPTED_RISK  // Known risk, stakeholder approved
  SUPPRESSED    // Matched a rule, hidden from view
}

enum ResponseType {
  FIXED             // User claims they fixed it
  ACKNOWLEDGED      // User saw it, hasn't fixed
  FALSE_POSITIVE    // Scanner got it wrong
  ACCEPTED_RISK     // Known issue, accepted by stakeholder
  WONT_FIX          // Low priority, not worth fixing
  EXPECTED_BEHAVIOR // This is by design
  NEEDS_REVIEW      // Escalate for review
}

enum RuleAction {
  SUPPRESS         // Hide from normal view
  REDUCE_SEVERITY  // Downgrade severity
  AUTO_ACKNOWLEDGE // Auto-mark as acknowledged
  FLAG_FOR_REVIEW  // Mark for human review
}

// ============================================
// SCANNER PATTERN RULES (Intelligent Context)
// ============================================

// Learned patterns that tell the scanner what's "normal"
model ScannerPatternRule {
  id String @id @default(cuid())

  // Rule identification
  name        String
  description String? @db.Text
  
  // What this rule applies to
  tablePattern   String  // 'raw.customers', 'raw.*', '*' for wildcards
  columnPattern  String  // '_batch_id', '*_id', '*'
  findingType    String  // 'duplicate', 'null_rate', 'outlier', etc.
  
  // The detected pattern
  patternType    PatternType
  
  // Pattern context (explains WHY this is expected)
  context        Json    // { "correlates_with": "batch_id", "group_size": 8, "explanation": "..." }
  
  // User confirmation status
  status         PatternRuleStatus @default(PENDING)
  confirmedBy    String?
  confirmedAt    DateTime?
  rejectedReason String?
  
  // Auto-detection metadata
  detectionConfidence Float    @default(0.5)  // 0-1 confidence
  timesSeen           Int      @default(1)    // How many times this pattern was detected
  lastSeenAt          DateTime @default(now())
  firstSeenAt         DateTime @default(now())
  
  // Rule behavior
  isActive    Boolean @default(true)
  priority    Int     @default(0)  // Higher = checked first
  expiresAt   DateTime?            // Optional expiration
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  // Applications of this rule
  applications PatternRuleApplication[]

  @@unique([organizationId, tablePattern, columnPattern, findingType, patternType])
  @@index([organizationId])
  @@index([status])
  @@index([patternType])
  @@index([isActive])
}

// Track when pattern rules are applied
model PatternRuleApplication {
  id String @id @default(cuid())

  // Which rule was applied
  rule   ScannerPatternRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId String

  // Scan context
  scanId     String
  tableName  String
  columnName String?
  
  // What action was taken
  action     PatternRuleAction
  
  // Details
  details    Json?   // Additional context about the application
  
  // Timestamp
  appliedAt DateTime @default(now())

  @@index([ruleId])
  @@index([scanId])
  @@index([appliedAt])
}

enum PatternType {
  COLUMN_CORRELATION    // Duplicates correlate with another column (e.g., batch_id)
  TIME_SNAPSHOT         // Daily/weekly snapshots causing duplicates
  SCD_VERSIONING        // Slowly changing dimension versioning
  FOREIGN_KEY           // Column is a foreign key (expected duplicates)
  GROUPING_KEY          // Column is a grouping/partition key
  EXPECTED_NULL         // Nulls are expected in this column
  EXPECTED_OUTLIER      // Outliers are expected (e.g., large orders)
  SEASONAL_PATTERN      // Seasonal variations are normal
  CUSTOM                // Custom user-defined pattern
}

enum PatternRuleStatus {
  PENDING    // Detected, awaiting user confirmation
  CONFIRMED  // User confirmed this is expected
  REJECTED   // User said this is NOT expected (flag as issue)
  AUTO_CONFIRMED // Confirmed automatically (high confidence + seen multiple times)
}

enum PatternRuleAction {
  SUPPRESSED           // Finding was suppressed due to rule
  NEEDS_CONFIRMATION   // Pattern detected, shown to user for confirmation
  FLAGGED              // No rule matched, flagged as issue
}
