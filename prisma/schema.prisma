// Prisma schema for Pallisade SaaS
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Onboarding
  timezone            String?
  role                String?
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  accounts       Account[]
  sessions       Session[]

  // Team membership
  teamMemberships TeamMember[]
  sentInvites     TeamInvite[] @relation("InviteSender")

  // App data
  reports              Report[]
  copilotSessions      CopilotSession[]
  notificationReads    NotificationRead[]
  notificationsActored NotificationEvent[] @relation("NotificationActor")
  notificationMutes    NotificationMute[]
  scanSchedules        ScanSchedule[]
  auditLogs            AuditLog[]
  appliedFixes         AppliedFix[]
  artifacts            Artifact[]

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// ORGANIZATION (Multi-tenant support)
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  logo      String?
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Company profile
  companySize  String?
  industry     String?
  dataTeamSize String?

  // SLO Configuration (default thresholds in hours)
  sloDefaults           Json? // { default: 24, realtime: 1, hourly: 2, daily: 25 }
  sloEnabled            Boolean    @default(true)
  alertOnSLOBreach      Boolean    @default(true)
  authPolicy            AuthPolicy @default(FLEXIBLE)
  authPolicyGraceUntil  DateTime?
  slaDiscoveryNodeLimit Int        @default(100)

  // Relations
  users            User[]
  reports          Report[]
  integrations     Integration[]
  dataContracts    DataContract[]
  lineageNodes     LineageNode[]
  lineageEdges     LineageEdge[]
  lineageSnapshots LineageSnapshot[]
  scanSchedules    ScanSchedule[]
  auditLogs        AuditLog[]
  appliedFixes     AppliedFix[]

  // Team Management
  teamMembers TeamMember[]
  teamInvites TeamInvite[]

  // Finding Response System
  findings Finding[]

  // Pipeline Stacks (Visual Pipeline Mapping)
  pipelineStacks PipelineStack[]

  // Copilot platform
  copilotSessions CopilotSession[]
  artifacts       Artifact[]

  // Coverage & Monitoring
  monitors        Monitor[]
  monitorGroups   MonitorGroup[]
  monitoringPlans MonitoringPlan[]

  // Notifications
  notificationEvents NotificationEvent[]
  notificationRoutes NotificationRoute[]
  notificationMutes  NotificationMute[]

  // Pipeline Monitoring Policies
  policyProfiles       PolicyProfile[]
  policyAssignments    PolicyAssignment[]
  driftRecommendations DriftRecommendation[]

  // SSO
  oidcConfig OrgOidcConfig?

  // Billing
  billingSubscription BillingSubscription?
  usageLedgers        UsageLedger[]
  creditBalance       CreditBalance?
  creditPurchases     CreditPurchase[]

  @@index([domain])
}

// ============================================
// TEAM MANAGEMENT & ROLES
// ============================================

// Explicit team membership with role
model TeamMember {
  id String @id @default(cuid())

  // Member info
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Role and permissions
  role        TeamRole @default(ENGINEER)
  permissions Json? // Override permissions (optional)

  // Status
  status    MemberStatus @default(ACTIVE)
  invitedAt DateTime     @default(now())
  joinedAt  DateTime     @default(now())

  // Metadata
  title      String? // Job title (e.g., "Data Engineer", "Analytics Lead")
  department String? // Team/department

  // Activity tracking
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

// Pending invitations
model TeamInvite {
  id String @id @default(cuid())

  // Invite details
  email String
  token String   @unique @default(cuid())
  role  TeamRole @default(ENGINEER)

  // Personalization
  personalNote String? @db.Text
  title        String? // Suggested job title
  department   String? // Suggested department

  // Status
  status    InviteStatus @default(PENDING)
  expiresAt DateTime // Invites expire after X days

  // Who sent it
  invitedBy   User?   @relation("InviteSender", fields: [invitedById], references: [id])
  invitedById String?
  inviterName String? // Denormalized for display

  // Organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Tracking
  emailSentAt DateTime?
  viewedAt    DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([token])
  @@index([status])
  @@index([email])
}

model OrgOidcConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuerUrl      String
  clientId       String
  clientSecret   String
  scopes         String       @default("openid email profile")
  displayName    String       @default("SSO")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum TeamRole {
  OWNER // Full control, can delete org, transfer ownership
  ADMIN // Manage team, integrations, settings (can't delete org)
  MANAGER // Run scans, view all data, manage contracts (can't manage team)
  ENGINEER // Run scans, use sandbox lab, view findings
  VIEWER // Read-only access to reports and dashboards
}

enum MemberStatus {
  ACTIVE
  INACTIVE // Temporarily disabled
  SUSPENDED // Admin suspended
}

enum InviteStatus {
  PENDING // Waiting for response
  ACCEPTED // User joined
  DECLINED // User declined
  EXPIRED // Past expiration date
  REVOKED // Admin cancelled
}

enum AuthPolicy {
  FLEXIBLE
  SSO_ONLY
}

// ============================================
// PIPELINE STACK (Visual Pipeline Mapping)
// ============================================

// The user's complete data pipeline stack
model PipelineStack {
  id String @id @default(cuid())

  // Stack identity
  name        String
  description String? @db.Text

  // Status
  status PipelineStackStatus @default(DRAFT)

  // Health metrics (calculated from scans)
  healthScore Float? // 0-100 overall health
  lastScanAt  DateTime?

  // Scheduled lineage extraction
  lastLineageExtractedAt   DateTime?
  lineageExtractionEnabled Boolean   @default(false)

  // Token usage limits and tracking
  tokenLimitMonthly   Int? // Monthly token limit (null = unlimited)
  tokensUsedThisMonth Int      @default(0)
  tokenResetDate      DateTime @default(now())

  // Created by
  createdById String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Pipeline components
  nodes PipelineNode[]
  edges PipelineEdge[]
  scans PipelineScan[]

  // Access control
  accessList PipelineAccess[]

  // Copilot context (onboarding data)
  context PipelineContext?

  // Contracts
  pipelineContract          PipelineContract?
  sourceContracts           SourceContract[]
  dataContracts             PipelineDataContract[]
  dataContractsEnabled      Boolean                @default(false)
  contractAllowOverrides    Boolean                @default(false) // Allow node-level SLA overrides when contracts exist
  contractViolationAlerting Boolean                @default(true) // Send alerts on contract violations

  // Notifications
  notificationEvents NotificationEvent[]

  @@index([organizationId])
  @@index([status])
}

// Pipeline context - stores learned knowledge from onboarding
model PipelineContext {
  id              String        @id @default(cuid())
  pipelineStack   PipelineStack @relation(fields: [pipelineStackId], references: [id], onDelete: Cascade)
  pipelineStackId String        @unique

  // Onboarding state
  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?

  // Learned context (JSON for flexibility)
  environmentContext  Json? // deployment method, team size, environments
  integrationContexts Json? // per-integration learned context (keyed by integration ID)
  conventionsContext  Json? // naming conventions, folder structures

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStackId])
  @@index([onboardingStatus])
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_UPDATE
}

// User access to a specific pipeline
model PipelineAccess {
  id String @id @default(cuid())

  // User with access
  userId String

  // Pipeline
  pipeline   PipelineStack @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String

  // Access level
  accessLevel PipelineAccessLevel @default(VIEWER)

  // Granted by
  grantedBy String?
  grantedAt DateTime @default(now())

  // Token usage tracking for this user on this pipeline
  tokensUsed Int @default(0)

  @@unique([userId, pipelineId])
  @@index([pipelineId])
  @@index([userId])
}

enum PipelineAccessLevel {
  OWNER // Full control, can delete and manage access
  EDITOR // Can modify pipeline configuration
  VIEWER // Read-only access
}

// A node in the pipeline (Fivetran, dbt, Snowflake, Tableau, etc.)
model PipelineNode {
  id String @id @default(cuid())

  // Node identity
  name String // User-friendly name

  // Node type and tool
  layer    PipelineLayer // INGESTION, TRANSFORMATION, WAREHOUSE, REPORTING
  toolType String // fivetran, airbyte, dbt_cloud, dbt_core, snowflake, bigquery, tableau, looker

  // Configuration (encrypted credentials)
  config Json? // Connection credentials/settings

  // Canvas position (for UI)
  positionX Float @default(0)
  positionY Float @default(0)

  // Connection status
  status       PipelineNodeStatus @default(PENDING)
  lastTestedAt DateTime?
  lastError    String?

  // Health metrics
  healthScore Float? // 0-100 based on recent scans
  lastScanAt  DateTime?

  // Scan results summary (cached)
  findingsCount Int @default(0)
  criticalCount Int @default(0)
  highCount     Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stack   PipelineStack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  stackId String

  // Link to existing Integration (optional, for backwards compatibility)
  integration   Integration? @relation(fields: [integrationId], references: [id])
  integrationId String?

  // Edges
  sourceEdges PipelineEdge[] @relation("SourceNode")
  targetEdges PipelineEdge[] @relation("TargetNode")

  // Findings from this node
  findings PipelineNodeFinding[]

  @@index([stackId])
  @@index([layer])
  @@index([toolType])
  @@index([status])
}

// Connection between nodes (data flow)
model PipelineEdge {
  id String @id @default(cuid())

  // Source -> Target (source is upstream of target)
  sourceId String
  targetId String
  source   PipelineNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target   PipelineNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  // Edge metadata
  label    String? // Optional label (e.g., "raw_events")
  dataFlow String? // Description of what data flows

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  stack   PipelineStack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  stackId String

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@index([stackId])
}

// A scan of the entire pipeline
model PipelineScan {
  id String @id @default(cuid())

  // Scan status
  status PipelineScanStatus @default(PENDING)

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  // Results summary
  totalFindings Int @default(0)
  criticalCount Int @default(0)
  highCount     Int @default(0)
  mediumCount   Int @default(0)
  lowCount      Int @default(0)

  // Health score calculated
  healthScore Float? // 0-100

  // Which layers were scanned
  layersScanned String[] // ['ingestion', 'transformation', 'warehouse', 'reporting']
  nodesScanned  Int      @default(0)

  // Error tracking
  errorMessage String?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  stack   PipelineStack @relation(fields: [stackId], references: [id], onDelete: Cascade)
  stackId String

  // Findings from this scan
  findings PipelineNodeFinding[]

  @@index([stackId])
  @@index([status])
  @@index([createdAt])
}

// Finding from a pipeline node scan
model PipelineNodeFinding {
  id String @id @default(cuid())

  // Finding details
  type        String // sync_failure, test_failed, stale_data, query_error, etc.
  severity    FindingSeverity
  title       String
  description String          @db.Text

  // Fix information
  suggestedFix Json? // { type: 'manual'|'sql'|'dbt'|'api', action: '', code: '' }

  // Root cause tracing
  rootCauseNodeId String? // If traced to upstream issue
  rootCauseType   String? // Type of root cause

  // Relations
  node   PipelineNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId String

  scan   PipelineScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId String

  // Timestamps
  createdAt DateTime @default(now())

  @@index([nodeId])
  @@index([scanId])
  @@index([severity])
  @@index([type])
}

enum PipelineStackStatus {
  DRAFT // Not yet configured
  CONFIGURING // Adding nodes
  READY // Ready for scanning
  SCANNING // Currently scanning
  ERROR // Configuration error
}

enum PipelineLayer {
  INGESTION // Fivetran, Airbyte, Stitch
  TRANSFORMATION // dbt, Airflow, Dagster
  WAREHOUSE // Snowflake, BigQuery, PostgreSQL, Redshift, Azure SQL, Databricks
  REPORTING // Tableau, Looker, Power BI, Metabase
  STORAGE // Amazon S3, Google Cloud Storage, Azure Data Lake Storage
  VERSION_CONTROL // GitHub, GitLab, Bitbucket
  ORCHESTRATION // Airflow, Dagster (standalone orchestration)
  INFRASTRUCTURE // Linux Server (SSH-based monitoring)
}

enum PipelineNodeStatus {
  PENDING // Not yet configured
  TESTING // Testing connection
  CONNECTED // Successfully connected
  HEALTHY // Connected and healthy
  WARNING // Connected but has issues
  ERROR // Connection failed
}

enum PipelineScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// UNIFIED DATA CONTRACTS
// ============================================

// Contract status lifecycle: DRAFT -> ACTIVE -> VIOLATED (auto) -> ACTIVE (fixed)
enum ContractStatus {
  DRAFT // Not yet enforced
  ACTIVE // Actively monitored
  VIOLATED // Currently failing SLAs
  DEPRECATED // No longer in use
}

model DataContract {
  id String @id @default(cuid())

  // === IDENTITY ===
  database  String
  schema    String @default("public")
  tableName String
  fullName  String // database.schema.table for easy lookup
  version   Int    @default(1) // Contract version for evolution

  // === STATUS & GOVERNANCE ===
  status      ContractStatus @default(DRAFT)
  publishedAt DateTime? // When contract went ACTIVE
  description String?        @db.Text

  // === OWNERSHIP ===
  owner      String? // Primary owner (team or person)
  ownerEmail String? // Owner email for notifications
  steward    String? // Secondary owner / data steward
  tags       String[] // For filtering/grouping

  // === BUSINESS CONTEXT ===
  businessDomain String? // e.g., "Finance", "Marketing", "Operations"
  dataTier       DataTier    @default(SILVER)
  criticality    Criticality @default(MEDIUM)
  businessImpact String?     @db.Text // "If this fails, X breaks"

  // === CONSUMERS & STAKEHOLDERS ===
  consumers     String[] // Teams/systems that consume this data
  stakeholders  String[] // People to notify on issues
  usedInReports String[] // Dashboard/report names

  // === FRESHNESS SLA ===
  freshnessEnabled      Boolean @default(true)
  freshnessHours        Int? // Max acceptable staleness
  freshnessWarningHours Int? // When to warn (before violation)
  timestampColumn       String? // Column to check for freshness
  sloTier               SLOTier @default(STANDARD)

  // === QUALITY SLA ===
  qualityEnabled   Boolean  @default(true)
  maxNullRate      Float? // Max acceptable null rate (0.0-1.0)
  maxDuplicateRate Float? // Max acceptable duplicate rate
  requiredColumns  String[] // Columns that must exist
  columnNullRules  Json? // Per-column null rate rules

  // === SCHEMA SLA ===
  schemaEnabled        Boolean @default(false)
  expectedSchema       Json? // Expected column definitions
  allowSchemaEvolution Boolean @default(true) // Allow additive changes

  // === VOLUME SLA ===
  volumeEnabled      Boolean @default(false)
  minRowCount        Int? // Minimum expected rows
  maxRowCount        Int? // Maximum expected rows
  expectedGrowthRate Float? // Expected daily growth %

  // === ALERTING ===
  slackChannel      String? // Slack channel for alerts
  pagerDutyService  String? // PagerDuty service ID
  emailRecipients   String[] // Additional email recipients
  alertOnWarning    Boolean  @default(true)
  alertOnViolation  Boolean  @default(true)
  alertCooldownMins Int      @default(60) // Min time between alerts

  // === COMPLIANCE TRACKING ===
  complianceScore   Float? // Current score (0-100)
  violationCount    Int       @default(0) // Total violations
  lastViolationAt   DateTime?
  lastCheckAt       DateTime?
  consecutivePasses Int       @default(0) // For auto-recovery

  // === DOWNSTREAM IMPACT (cached) ===
  downstreamCount    Int? // Tables that depend on this
  downstreamCritical Int? // Critical downstream tables
  upstreamCount      Int? // Tables this depends on
  impactScore        Float? // Calculated blast radius score
  lastImpactUpdate   DateTime?

  // === ML/ANOMALY DETECTION ===
  anomalyEnabled     Boolean   @default(false)
  historicalPatterns Json? // Learned patterns
  anomalyThreshold   Float?    @default(0.95)
  lastMLUpdate       DateTime?

  // === TIMESTAMPS ===
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === RELATIONS ===
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?

  @@unique([organizationId, fullName])
  @@index([organizationId])
  @@index([integrationId])
  @@index([fullName])
  @@index([status])
}

enum DataTier {
  GOLD // Mission-critical, page immediately
  SILVER // Important, alert within SLO
  BRONZE // Nice-to-have, batch alerts
}

enum SLOTier {
  REALTIME // 1 hour SLO
  HOURLY // 2 hour SLO
  STANDARD // 24 hour SLO (default)
  DAILY // 25 hour SLO
  WEEKLY // 168 hour SLO
  CUSTOM // Use freshnessHours field
}

enum Criticality {
  CRITICAL // Business-critical, alert immediately
  HIGH // Important, fix within 24h
  MEDIUM // Standard priority
  LOW // Best effort
}

// ============================================
// PIPELINE MONITORING POLICIES
// ============================================
// Monitoring Policy is a SEPARATE concept from DataContract.
// - Monitoring Policy = lightweight operational expectations (freshness, strictness,
//   sensitivity). Cross-domain (warehouse, ingestion, BI, orchestration, transform).
//   Used to drive monitor defaults and auto-config. No lifecycle/compliance tracking.
// - DataContract = governance/compliance artifact. Warehouse-table-specific. Has
//   lifecycle (DRAFT/ACTIVE/VIOLATED/DEPRECATED), ownership, violation history.

// Reusable monitoring expectation template.
// Users can assign these profiles to assets/nodes on the lineage graph.
model PolicyProfile {
  id          String  @id @default(cuid())
  name        String // "Critical SLA", "Standard", "Relaxed"
  description String?
  isBuiltIn   Boolean @default(false) // System-provided, non-deletable

  // Scope: which node types this profile targets (null = any)
  targetDomain String? // "warehouse"|"ingestion"|"bi"|"orchestration"|"transform"|null
  criticality  String? // Maps to Criticality enum. null = any.

  // Threshold configs (Json blobs, domain-specific sections)
  freshnessConfig     Json? // { enabled, maxHours, warningHours }
  schemaConfig        Json? // { enabled, strictness: "strict"|"warn"|"ignore", allowEvolution }
  volumeConfig        Json? // { enabled, minRows, maxRows, growthRateThreshold }
  anomalyConfig       Json? // { enabled, sensitivity: 0.0-1.0, lookbackDays }
  qualityConfig       Json? // { enabled, maxNullRate, maxDuplicateRate }
  ingestionConfig     Json? // { syncLagToleranceMinutes, failureTolerance, schemaDriftStrictness }
  biConfig            Json? // { freshnessHours, contentHealthEnabled, upstreamBreakStrictness }
  orchestrationConfig Json? // { runLatencyMinutes, scheduleLagMinutes, failureTolerance }
  transformConfig     Json? // { testFailureTolerance, modelFreshnessHours }

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  assignments PolicyAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Links a PolicyProfile to a target (node, domain, or criticality tier).
// Each target can have at most one assignment per assignment type.
// Assignment types:
//   "direct"             — explicit per-node assignment (highest precedence)
//   "branch"             — applies to all downstream of branchRootFqn
//   "criticality_default"— default for a (domain, criticality) pair
//   "domain_default"     — default for an entire domain
model PolicyAssignment {
  id String @id @default(cuid())

  profileId String
  profile   PolicyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Target — exactly one group is set depending on assignmentType
  nodeFqn         String? // For "direct": asset FQN (durable across graph rebuilds)
  nodeDomain      String? // For "domain_default" and "criticality_default"
  nodeCriticality String? // For "criticality_default" only
  branchRootFqn   String? // For "branch": root FQN, applies to all downstream

  // Assignment scope
  assignmentType String // "direct"|"domain_default"|"criticality_default"|"branch"

  // Per-asset overrides (sparse — only set fields override the profile)
  overrides Json?

  // Status management
  status     String    @default("active") // 'active' | 'inactive' | 'archived'
  archivedAt DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Uniqueness: one assignment per target per type
  @@unique([organizationId, assignmentType, nodeFqn])
  @@unique([organizationId, assignmentType, branchRootFqn])
  @@unique([organizationId, assignmentType, nodeDomain, nodeCriticality])
  @@index([organizationId])
  @@index([nodeFqn])
  @@index([nodeDomain])
  @@index([branchRootFqn])
}

// ============================================
// DATA LINEAGE
// ============================================

model LineageNode {
  id String @id @default(cuid())

  // Table identification
  name      String // Fully qualified: database.schema.table
  database  String?
  schema    String?
  tableName String

  // Node metadata
  nodeType       String      @default("table") // table, view, source, model
  platform       String? // Source tool: bigquery, dbt_core, n8n, airflow, etc.
  description    String?     @db.Text
  owner          String?
  tags           String[]
  criticality    Criticality @default(MEDIUM)
  businessDomain String?

  // Stats
  rowCount    Int?
  lastUpdated DateTime?

  // Computed
  upstreamCount   Int @default(0)
  downstreamCount Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?

  // Edges
  upstreamEdges   LineageEdge[] @relation("downstream")
  downstreamEdges LineageEdge[] @relation("upstream")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([integrationId])
  @@index([name])
}

model LineageEdge {
  id String @id @default(cuid())

  // Source -> Target (source is upstream of target)
  sourceId String
  targetId String
  source   LineageNode @relation("upstream", fields: [sourceId], references: [id], onDelete: Cascade)
  target   LineageNode @relation("downstream", fields: [targetId], references: [id], onDelete: Cascade)

  // Edge metadata
  edgeType       String   @default("depends_on") // depends_on, derived_from, joins
  columns        String[] // Columns involved in this edge
  transformation String?  @db.Text // SQL snippet if available

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@index([organizationId])
}

model LineageSnapshot {
  id String @id @default(cuid())

  // Snapshot metadata
  source  String // query_history, dbt_manifest, manual
  dialect String // snowflake, bigquery, postgres

  // Stats
  nodeCount Int @default(0)
  edgeCount Int @default(0)
  rootCount Int @default(0)
  leafCount Int @default(0)

  // The full graph as JSON (for fast retrieval)
  graphData Json?

  // Status
  status       String  @default("building") // building, ready, failed
  errorMessage String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?

  @@index([organizationId])
  @@index([integrationId])
}

enum Plan {
  STARTER      // Legacy — maps to GROWTH
  PROFESSIONAL // Legacy — maps to BUSINESS
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum BillingPlan {
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ============================================
// SECURITY REPORTS
// ============================================

model Report {
  id          String       @id @default(cuid())
  title       String
  type        ReportType
  status      ReportStatus @default(PENDING)
  packageSlug String // Links to service package (e.g., "perimeter-pulse")

  // Scores & Summary
  overallScore     Int? // 0-100
  criticalCount    Int     @default(0)
  highCount        Int     @default(0)
  mediumCount      Int     @default(0)
  lowCount         Int     @default(0)
  executiveSummary String? @db.Text

  // Report content (JSON for flexibility)
  findings        Json? // Array of findings
  recommendations Json? // Array of recommendations
  rawData         Json? // Raw scan data from external scanners

  // Files
  pdfUrl String?

  // Timestamps
  scanStartedAt   DateTime?
  scanCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  // Finding Response System
  findingsTracked Finding[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
}

enum ReportType {
  PERIMETER_SECURITY
  SAAS_IDENTITY
  CLOUD_RECOVERY
  DATA_FRESHNESS
  DATA_QUALITY
  SCHEMA_DRIFT
  DATA_INTEGRITY
  DATA_ANOMALY
  PIPELINE_HEALTH
  TEST_COVERAGE
  AI_READINESS
  FUSION_BUNDLE
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ============================================
// SCAN SCHEDULES
// ============================================

model ScanSchedule {
  id String @id @default(cuid())

  // Schedule name and description
  name        String
  description String?

  // What to scan
  scanTypes String[] // ['freshness', 'quality', 'volume', 'anomaly']
  tables    String[] // Empty = all tables, or specific table names

  // When to scan (cron expression)
  cronExpression String // e.g., "0 * * * *" for hourly
  timezone       String @default("UTC")

  // Status
  enabled Boolean @default(true)

  // Notification settings
  notifyOnSuccess Boolean  @default(false)
  notifyOnFailure Boolean  @default(true)
  notifyChannels  String[] // ['slack', 'email', 'pagerduty']
  emailRecipients String[] @default([])

  // Execution tracking
  lastRunAt       DateTime?
  lastRunStatus   String? // 'success', 'failed', 'running'
  lastRunReportId String?
  nextRunAt       DateTime?
  runCount        Int       @default(0)
  failureCount    Int       @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdById    String?

  @@index([organizationId])
  @@index([enabled])
  @@index([nextRunAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ============================================
// COPILOT SESSIONS (Enhanced AI Assistant)
// ============================================

model CopilotSession {
  id    String @id @default(cuid())
  title String @default("New Chat")

  // Context - what is this chat about?
  contextType     CopilotContextType @default(GENERAL)
  pipelineStackId String?
  nodeIds         String[] // Array of node IDs being discussed

  // Debug session tracking
  isDebugSession Boolean @default(false)
  debugIssueId   String?

  // LLM configuration
  model String @default("claude-sonnet")

  // Conversation summary for long chats
  memorySummary String? @db.Text

  // Token tracking
  totalInputTokens  Int @default(0)
  totalOutputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  messages       CopilotMessage[]
  changePlans    ChangePlan[]
  artifacts      Artifact[]

  @@index([userId])
  @@index([organizationId])
  @@index([contextType])
}

model CopilotMessage {
  id      String      @id @default(cuid())
  role    MessageRole
  content String      @db.Text

  // Tool calls made by AI
  toolCalls Json?

  // Tool results returned
  toolResults Json?

  // Context retrieved for this message
  contextUsed Json?

  // Token tracking
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  session   CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  @@index([sessionId])
}

enum CopilotContextType {
  GENERAL // General Q&A about the data stack
  PIPELINE // Focused on a specific pipeline
  DEBUGGING // Active debugging session
  BUILDING // Building/configuring pipeline
}

// ============================================
// NOTIFICATIONS
// ============================================

model NotificationEvent {
  id              String               @id @default(cuid())
  organizationId  String
  pipelineStackId String?
  actorUserId     String?
  eventType       String
  severity        NotificationSeverity @default(INFO)
  title           String
  message         String
  dedupeKey       String?
  entityType      String?
  entityId        String?
  actionUrl       String?
  metadata        Json?
  createdAt       DateTime             @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id])
  pipelineStack PipelineStack?     @relation(fields: [pipelineStackId], references: [id])
  actorUser     User?              @relation("NotificationActor", fields: [actorUserId], references: [id])
  reads         NotificationRead[]

  @@index([organizationId, createdAt])
  @@index([organizationId, eventType])
  @@index([pipelineStackId])
  @@index([dedupeKey, createdAt])
  @@index([entityType, entityId])
}

enum NotificationSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
  ORG_DEFAULTS
}

model NotificationRead {
  id                  String   @id @default(cuid())
  userId              String
  notificationEventId String
  readAt              DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id])
  notificationEvent NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationEventId])
  @@index([userId])
}

model NotificationRoute {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  severity         NotificationSeverity
  enabled          Boolean              @default(true)
  notifyOnRecovery Boolean              @default(false)
  destinations     Json                 @default("[]")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([organizationId, severity])
  @@index([organizationId])
}

model NotificationMute {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String
  entityType     String?
  entityId       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
  @@index([eventType, entityType, entityId])
}

// ============================================
// BILLING & USAGE METERING
// ============================================

model BillingSubscription {
  id                       String        @id @default(cuid())
  orgId                    String        @unique
  paystackCustomerCode     String
  paystackSubscriptionCode String?
  paystackEmailToken       String?       // needed to manage subscriptions via PayStack API
  plan                     BillingPlan
  status                   BillingStatus @default(ACTIVE)
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  tokenAllowance           Int
  storageAllowanceGb       Int
  memberAllowance          Int
  pipelineAllowance        Int           @default(3)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usageLedgers UsageLedger[]

  @@index([paystackCustomerCode])
}

model UsageLedger {
  id               String    @id @default(cuid())
  orgId            String
  periodStart      DateTime
  periodEnd        DateTime
  tokensUsed       Int       @default(0)
  storageUsedGb    Float     @default(0)
  lastStorageScanAt DateTime?
  notifiedAt80Pct  DateTime?
  notifiedAt100Pct DateTime?
  updatedAt        DateTime  @updatedAt

  organization         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade, map: "UsageLedger_org_fkey")
  billingSubscription  BillingSubscription? @relation(fields: [orgId], references: [orgId], map: "UsageLedger_billing_fkey")

  @@unique([orgId, periodStart])
  @@index([orgId])
}

model CreditBalance {
  id              String   @id @default(cuid())
  orgId           String   @unique
  tokensRemaining Int      @default(0)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model CreditPurchase {
  id                    String   @id @default(cuid())
  orgId                 String
  tokensAmount          Int
  pricePaid             Int      // kobo/cents
  paystackReference     String
  createdAt             DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([eventId])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id String @id @default(cuid())

  // What happened
  action      String // 'scan.started', 'integration.created', 'user.login', etc.
  category    String // 'scan', 'integration', 'user', 'schedule', 'settings'
  description String // Human-readable description

  // Who did it
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  userEmail String? // Denormalized for display
  userName  String? // Denormalized for display

  // Context
  resourceType String? // 'Report', 'Integration', 'Schedule', etc.
  resourceId   String? // ID of the affected resource
  resourceName String? // Name of the affected resource

  // Details
  metadata  Json? // Additional context (old/new values, etc.)
  ipAddress String? // Request IP
  userAgent String? // Browser/client info

  // Status
  status       String  @default("success") // 'success', 'failure', 'pending'
  errorMessage String? // If status is failure

  // Timestamp
  createdAt DateTime @default(now())

  // Organization scope
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@index([resourceType, resourceId])
}

// ============================================
// APPLIED FIXES (One-Click Fix Tracking)
// ============================================

model AppliedFix {
  id String @id @default(cuid())

  // What fix was applied
  fixType  String // 'dbt_freshness', 'dbt_null_test', 'sql_script', etc.
  fixTitle String
  fixCode  String @db.Text
  language String // 'yaml', 'sql', 'python'

  // Where it was applied
  repoOwner  String // GitHub owner/org
  repoName   String // Repository name
  filePath   String // Path in repo where fix was applied
  branchName String // Branch created for the fix
  writeMode  String // 'create', 'append', 'replace'

  // GitHub references
  commitSha String? // Commit SHA
  prNumber  Int? // Pull Request number
  prUrl     String? // Full PR URL
  prStatus  String  @default("open") // 'open', 'merged', 'closed'

  // Link to the original finding
  reportId     String?
  findingId    String? // ID within the report's findings array
  findingTitle String?
  table        String? // Affected table (if applicable)
  column       String? // Affected column (if applicable)

  // Issue context for learning
  issueType     String? // 'freshness', 'null_spike', 'volume_drop'
  issueCategory String? // 'data_quality', 'pipeline', 'security'
  severity      String? // 'critical', 'high', 'medium', 'low'

  // Metrics at time of fix (for before/after comparison)
  metricSnapshot Json? // { "null_rate": 0.35, "freshness_hours": 48 }

  // Fix generation context
  confidenceScore  Float? // AI confidence when generating fix
  generationMethod String? // 'template', 'rag', 'learned'

  // Status tracking
  status       AppliedFixStatus @default(PENDING)
  appliedAt    DateTime         @default(now())
  mergedAt     DateTime?
  errorMessage String?

  // Who applied it
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Organization
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  // Link from ChangePlan (one-to-one)
  changePlan ChangePlan?

  @@index([organizationId])
  @@index([userId])
  @@index([reportId])
  @@index([prStatus])
  @@index([status])
  @@index([issueType])
  @@index([table])
}

enum AppliedFixStatus {
  PENDING // PR created, awaiting merge
  MERGED // PR merged successfully
  CLOSED // PR closed without merge
  FAILED // Failed to create PR
}

// ============================================
// CHANGE PLANS (Structured Fix Proposals)
// ============================================

// A structured change plan generated by Scout with patches and validation
model ChangePlan {
  id          String  @id @default(cuid())
  version     Int     @default(1)
  title       String
  description String? @db.Text
  rootCause   String? @db.Text

  // Patches and validation state (stored as JSON)
  patches        Json // Array of FilePatch objects
  validations    Json? // Dict of ValidationLevel -> ValidationResult
  impactAnalysis Json? // Impact analysis details

  // Status tracking
  status ChangePlanStatus @default(DRAFT)

  // GitHub PR details (if applied)
  prUrl      String?
  prNumber   Int?
  branchName String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who created it
  createdBy String? // User ID or "scout"

  // Relations
  copilotSession CopilotSession? @relation(fields: [sessionId], references: [id])
  sessionId      String?

  // Link to applied fix if applied
  appliedFix   AppliedFix? @relation(fields: [appliedFixId], references: [id])
  appliedFixId String?     @unique

  @@index([status])
  @@index([sessionId])
  @@index([createdAt])
}

enum ChangePlanStatus {
  DRAFT // Initial state, not yet validated
  VALIDATING // Validation in progress
  VALIDATED // Passed required validations
  APPLYING // Creating GitHub PR
  APPLIED // PR created successfully
  FAILED // Validation or apply failed
  REJECTED // User rejected the plan
}

// ============================================
// N8N INTEGRATIONS
// ============================================

model Integration {
  id     String            @id @default(cuid())
  name   String // Display name (e.g., "Production Snowflake")
  type   IntegrationType
  status IntegrationStatus @default(INACTIVE)

  // Credentials (encrypted at rest)
  credentials Json? // Encrypted connection credentials

  // OAuth tokens (for GitHub, Slack, etc.)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  // Config & metadata
  config   Json? // Type-specific config (e.g., database names, repos)
  metadata Json? // Discovered metadata (tables, jobs, etc.)

  // Connection info (for display)
  connectionInfo String? // Human-readable connection summary

  // Health tracking
  lastSyncAt  DateTime?
  lastTestAt  DateTime?
  lastError   String?
  healthScore Int? // 0-100 based on recent scans

  // Scan tracking
  scanCount  Int       @default(0)
  lastScanAt DateTime?

  // Extraction timestamps (populated by extraction flows)
  lastExtractedAt        DateTime?
  lastLineageExtractedAt DateTime?
  lastSchemaExtractedAt  DateTime?
  lastLogsExtractedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id])
  organizationId   String
  dataContracts    DataContract[]
  lineageNodes     LineageNode[]
  lineageSnapshots LineageSnapshot[]
  scanSchedules    ScanSchedule[]
  findings         Finding[]

  // Pipeline nodes that use this integration
  pipelineNodes PipelineNode[]

  // Universal monitors
  monitors Monitor[]

  // Source contract (1:1)
  sourceContract SourceContract?

  @@unique([organizationId, type, name]) // Prevent duplicate connections
  @@index([organizationId])
  @@index([type])
  @@index([status])
}

// Ownership + expectations contract for an integration source (1:1 with Integration)
model SourceContract {
  id String @id @default(cuid())

  // Ownership
  ownerUser      String? // User name or ID
  ownerTeam      String? // Team name or ID
  contactChannel String? // e.g. #data-alerts, ops@company.com

  // SLA
  slaTier String? // T0, T1, T2, T3

  // Expectations
  expectedFreshnessMinutes           Int? // How fresh data should be
  expectedExtractionFrequencyMinutes Int? // How often extraction should run

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pipeline inheritance
  inheritFromPipeline Boolean @default(true)
  overridesJson       Json? // Tool-specific overrides validated by integration type

  // Relations
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String      @unique

  pipelineStack   PipelineStack? @relation(fields: [pipelineStackId], references: [id])
  pipelineStackId String?

  @@index([integrationId])
  @@index([pipelineStackId])
}

// Pipeline-level contract — sets defaults for all tools in a pipeline
model PipelineContract {
  id String @id @default(cuid())

  // Ownership
  ownerUser      String?
  ownerTeam      String?
  contactChannel String?

  // SLA
  slaTier String? // T0, T1, T2, T3

  // Expectations
  expectedFreshnessMinutes           Int?
  expectedExtractionFrequencyMinutes Int?

  // Alert routing
  alertPolicyJson Json? // { channels: [], severityRouting: {} }

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation — 1:1 with PipelineStack
  pipelineStack   PipelineStack @relation(fields: [pipelineStackId], references: [id], onDelete: Cascade)
  pipelineStackId String        @unique

  @@index([pipelineStackId])
}

// Group-level or exception contract for pipeline data assets
// (distinct from DataContract which is org-scoped, per-table)
model PipelineDataContract {
  id String @id @default(cuid())

  // Scope — scopeRef is the unique identifier, scope is legacy type
  scope    String // 'schema' | 'dbt_model_group' | 'dashboard' | 'exception'
  scopeRef String // e.g., "bigquery:public", "staging", dashboard ID
  name     String? // Optional human-friendly name for this contract

  // Covered nodes
  nodeFqns Json? // string[] — FQNs of lineage nodes covered by this contract

  // Ownership
  ownerUser      String?
  ownerTeam      String?
  contactChannel String?

  // SLA tier
  slaTier String? // T0, T1, T2, T3
  notes   String? @db.Text

  // Domain-specific SLA config sections (same structure as PolicyProfile)
  freshnessConfig     Json? // { enabled, maxHours, warningHours }
  schemaConfig        Json? // { enabled, strictness, allowEvolution }
  volumeConfig        Json? // { enabled, minRows, maxRows, growthRateThreshold }
  anomalyConfig       Json? // { enabled, sensitivity, lookbackDays }
  qualityConfig       Json? // { enabled, maxNullRate, maxDuplicateRate }
  ingestionConfig     Json? // { syncLagToleranceMinutes, failureTolerance, schemaDriftStrictness }
  biConfig            Json? // { freshnessHours, contentHealthEnabled, upstreamBreakStrictness }
  orchestrationConfig Json? // { runLatencyMinutes, scheduleLagMinutes, failureTolerance }
  transformConfig     Json? // { testFailureTolerance, modelFreshnessHours }

  // Legacy fields (kept for backwards compat with existing records)
  expectedFreshnessMinutes           Int?
  expectedExtractionFrequencyMinutes Int?
  alertPolicyJson                    Json?

  // Data-asset-specific
  schemaExpectations Json? // SchemaExpectation[]
  qualityRules       Json? // QualityRule[]

  // Override fields
  overridesJson Json?

  // Exception contract support
  isException      Boolean                @default(false)
  parentContractId String?
  parentContract   PipelineDataContract?  @relation("ExceptionParent", fields: [parentContractId], references: [id])
  exceptions       PipelineDataContract[] @relation("ExceptionParent")

  // Auto-sync tracking
  autoSynced Boolean @default(false)

  // Status management
  status     String    @default("active") // 'active' | 'inactive' | 'archived'
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to pipeline
  pipelineStack   PipelineStack @relation(fields: [pipelineStackId], references: [id], onDelete: Cascade)
  pipelineStackId String

  @@unique([pipelineStackId, scope, scopeRef])
  @@index([pipelineStackId])
  @@index([parentContractId])
}

enum IntegrationType {
  // ===========================================
  // WAREHOUSE (Layer: WAREHOUSE)
  // ===========================================
  SNOWFLAKE // Primary cloud data warehouse
  BIGQUERY // Google Cloud data warehouse
  POSTGRES // PostgreSQL (also covers Supabase, RDS, etc.)
  REDSHIFT // AWS data warehouse
  SQLSERVER // On-premise SQL Server
  AZURE_SQL // Azure SQL Database
  AZURE_SYNAPSE // Azure Synapse Analytics

  // ===========================================
  // INGESTION (Layer: INGESTION)
  // ===========================================
  FIVETRAN // Managed ETL/ELT
  AIRBYTE // Open-source ELT
  STITCH // Singer-based ETL

  // ===========================================
  // TRANSFORMATION (Layer: TRANSFORMATION)
  // ===========================================
  DBT_CLOUD // dbt Cloud (hosted)
  DBT_CORE // dbt Core (self-hosted/manifest upload)
  AIRFLOW // Apache Airflow orchestration
  DAGSTER // Dagster orchestration
  PREFECT // Prefect orchestration
  N8N // n8n workflow automation

  // ===========================================
  // REPORTING (Layer: REPORTING)
  // ===========================================
  TABLEAU // Tableau dashboards
  LOOKER // Looker / Looker Studio
  POWERBI // Microsoft Power BI
  METABASE // Open-source BI

  // ===========================================
  // DATA WAREHOUSES (Additional)
  // ===========================================
  DATABRICKS // Databricks Lakehouse Platform

  // ===========================================
  // CLOUD STORAGE
  // ===========================================
  AMAZON_S3 // Amazon S3 object storage
  GCS // Google Cloud Storage
  ADLS // Azure Data Lake Storage

  // ===========================================
  // CODE & VERSION CONTROL
  // ===========================================
  GITHUB // For fix PRs
  GITLAB
  BITBUCKET

  // ===========================================
  // NOTIFICATIONS
  // ===========================================
  SLACK
  PAGERDUTY
  OPSGENIE
  TEAMS // Microsoft Teams

  // ===========================================
  // INFRASTRUCTURE
  // ===========================================
  LINUX_SERVER // Linux/Unix server (SSH)

  // ===========================================
  // OTHER
  // ===========================================
  JIRA // Issue tracking
  CUSTOM_WEBHOOK // Generic webhook
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// ============================================
// FINDING RESPONSE SYSTEM
// ============================================

// Individual scan finding that can be tracked and responded to
model Finding {
  id String @id @default(cuid())

  // Finding identification (unique per scan context)
  fingerprint String // Hash of table+column+type+description for deduplication

  // Finding details
  table       String
  column      String?
  scanType    String // freshness, quality, volume, schema, anomaly, distribution, integrity
  findingType String // null_rate, negative_value, duplicate, orphan, stale, etc.
  severity    FindingSeverity

  // Finding content
  title       String
  description String @db.Text
  details     Json? // Additional context (sample values, counts, etc.)

  // Fix information
  suggestedFix  String? @db.Text
  fixType       String? // sql, dbt_test, pipeline_config, manual
  fixConfidence Float? // 0-1 confidence in the suggested fix

  // State
  status      FindingStatus @default(OPEN)
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  resolvedAt  DateTime?

  // Scan context
  scanCount Int @default(1) // How many times this was detected

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  integration    Integration? @relation(fields: [integrationId], references: [id])
  integrationId  String?
  report         Report?      @relation(fields: [reportId], references: [id])
  reportId       String?

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([integrationId])
  @@index([status])
  @@index([severity])
  @@index([scanType])
  @@index([fingerprint])
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN // New/unaddressed
  IN_PROGRESS // Being worked on
  RESOLVED // Fixed and verified
  WONT_FIX // Acknowledged, won't be fixed
  FALSE_POSITIVE // Not a real issue
  ACCEPTED_RISK // Known risk, stakeholder approved
  SUPPRESSED // Matched a rule, hidden from view
}

// ============================================
// ARTIFACTS (Saved LLM Responses)
// ============================================

model Artifact {
  id      String       @id @default(cuid())
  title   String
  content String       @db.Text
  type    ArtifactType
  tags    String[]

  // Source reference (link back to original chat)
  sourceSessionId String?
  sourceMessageId String?
  sourceSession   CopilotSession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  metadata Json?
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([userId])
  @@index([organizationId])
  @@index([type])
}

enum ArtifactType {
  QUERY // SQL queries
  FIX // Bug fixes, config fixes
  INSIGHT // Analysis, explanations
  CODE // Code snippets
  PLAN // Implementation plans
}

// ==========================================
// Universal Monitor Definitions
// ==========================================

model Monitor {
  id   String @id @default(cuid())
  name String

  // Monitor configuration
  monitorType    MonitorKind?
  targetFqn      String? // database.schema.table (optional for prompt tasks)
  targetDatabase String?
  targetSchema   String?
  targetTable    String?
  config         Json? // Monitor-specific config (thresholds, columns, etc.)

  // Scheduling
  enabled    Boolean           @default(true)
  schedule   String? // Cron expression
  lastRunAt  DateTime?
  lastStatus MonitorRunStatus?
  nextRunAt  DateTime?

  // Baseline data (for anomaly detection)
  baselineMean      Float?
  baselineStddev    Float?
  baselineCount     Int?
  baselineUpdatedAt DateTime?

  // Task mode
  taskMode    String? // "prompt" | "structured"
  prompt      String? // Natural-language prompt (for prompt mode)
  description String? // Human-readable description

  // Alert configuration
  alertChannels   String[] // ["slack", "email", "pagerduty"]
  alertConfig     Json? // Channel-specific config overrides
  alertOnStatus   String[] // ["FAIL", "WARN", "ERROR"] — which statuses trigger alerts
  lastAlertStatus String? // Last status that triggered an alert (for dedup)
  lastAlertAt     DateTime? // When the last alert was sent (for suppression window)
  timezone        String?   @default("UTC")

  // Policy override tracking
  policyOverrides String[] // Config field keys overridden by user (e.g. ["max_hours"])

  // Metadata
  createdBy  String?
  source     String? // "pallisade", "elementary", "monte_carlo", etc.
  externalId String? // ID in the external system

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String
  integration          Integration?          @relation(fields: [integrationId], references: [id])
  integrationId        String?
  monitorGroup         MonitorGroup?         @relation(fields: [monitorGroupId], references: [id], onDelete: SetNull)
  monitorGroupId       String?
  runs                 MonitorRun[]
  baselines            MonitorBaseline[]
  driftRecommendations DriftRecommendation[]

  @@unique([organizationId, targetFqn, monitorType])
  @@index([organizationId])
  @@index([targetFqn])
  @@index([monitorType])
  @@index([enabled])
  @@index([monitorGroupId])
}

model MonitorRun {
  id String @id @default(cuid())

  // Result
  status      MonitorRunStatus
  value       Float?
  threshold   Float?
  message     String?
  details     Json?
  sqlExecuted String?

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  // Relations
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String

  @@index([monitorId])
  @@index([startedAt])
  @@index([status])
}

model MonitorBaseline {
  id String @id @default(cuid())

  // What was measured
  metricName  String // e.g. "row_count", "null_rate", "hours_since_update"
  metricValue Float // The observed metric value

  // Time context
  measuredAt DateTime @default(now())
  dayOfWeek  Int? // 0=Sunday..6=Saturday (for seasonality queries)
  hourOfDay  Int? // 0-23 (for sub-daily patterns)

  // Optional context
  targetFqn String? // Denormalized for fast queries without joining Monitor
  details   Json? // Extra context (e.g. { column: "email" })

  // Relations
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String

  @@index([monitorId, metricName, measuredAt])
  @@index([monitorId, metricName, dayOfWeek])
  @@index([measuredAt])
}

enum MonitorKind {
  // Warehouse data quality — canonical monitor set
  FRESHNESS
  VOLUME
  SCHEMA_CHANGE
  REFERENTIAL
  CUSTOM_SQL
  ANOMALY // Backend for Outlier Detection
  NULL_CHECK // Null rate monitoring (replaces NULL_RATE)
  UNIQUENESS_CHECK // Duplicate detection (replaces UNIQUENESS)
  RANGE_VALIDATION // Numeric bounds checking
  ACCEPTED_VALUES // Categorical value set validation
  DATE_CONSISTENCY // Cross-column date assertions
  DATA_TYPE_VALIDATION // Column type validation
  OUTLIER_DETECTION // Alias for ANOMALY in user-facing catalog
  // Legacy warehouse types — kept for backward compatibility
  NULL_RATE // Deprecated: use NULL_CHECK
  UNIQUENESS // Deprecated: use UNIQUENESS_CHECK
  DISTRIBUTION // Deprecated: use OUTLIER_DETECTION
  // Infrastructure monitors
  CERTIFICATE // Infrastructure: TLS/SSL cert expiry
  SERVER_HEALTH // Infrastructure: CPU, memory, disk
  LOG_ANALYSIS // Infrastructure: log file error scanning
  // Warehouse observability
  QUERY_PERFORMANCE
  COST_ANOMALY
  STORAGE_GROWTH
  // Ingestion monitors (Fivetran, Airbyte)
  SYNC_LAG
  FAILED_SYNCS
  CONNECTOR_SCHEMA_DRIFT
  // Orchestration monitors (Airflow, Dagster)
  DAG_LAST_RUN
  DAG_SCHEDULE_LAG
  TASK_FAILURE_RATE
  // Transformation monitors (dbt Cloud, dbt Core)
  DBT_TEST_FAILURES
  DBT_MODEL_FRESHNESS
  DBT_SOURCE_FRESHNESS
  DBT_CORE_SOURCE_VALIDATION
  DBT_CORE_REF_INTEGRITY
  // BI / Reporting monitors
  BI_FRESHNESS_PROXY
  BI_UPSTREAM_BREAK_RISK
  BI_CONTENT_HEALTH
  BI_REFRESH_FAILURE
  // AI-powered monitors
  AI_PROMPT // LLM-based custom business logic monitor
}

enum MonitorRunStatus {
  PASS
  WARN
  FAIL
  ERROR
  SKIPPED
  RUNNING
}

model MonitorGroup {
  id           String  @id @default(cuid())
  name         String
  description  String?
  groupType    String // "upstream_stability", "reporting_health", "asset_stability", "custom"
  anchorFqn    String? // FQN of the anchor node whose upstream defines this group
  anchorNodeId String? // Engine lineage node ID for re-computing membership

  enabled  Boolean @default(true)
  schedule String? // Shared cron expression
  timezone String? @default("UTC")

  // Alert configuration (shared for the group)
  alertChannels String[]
  alertOnStatus String[]
  alertConfig   Json?

  // Aggregate status (derived from member monitors)
  lastStatus MonitorRunStatus?
  lastRunAt  DateTime?

  // Group Monitor fields (null for legacy bundles)
  watchType      String? // "pipeline_health"|"dashboard_shield"|"source_guard"|"model_quality"|"custom_watch"
  scopeConfig    Json? // { maxDepth, maxNodes, maxMonitors, domainFilters, includeNodeIds, excludeNodeIds }
  coveragePct    Float? // 0.0-1.0
  healthScore    Float? // 0.0-100.0
  healthDetails  Json? // HealthReport blob
  lastHealthAt   DateTime?
  anchorNodeType String? // cached: "dashboard"|"table"|"connector" etc.
  anchorPlatform String? // cached: "bigquery"|"looker" etc.

  // Preset group fields (null for non-preset watches)
  presetGroupId String? // Groups watches from same preset application
  presetKey     String? // "pipeline_health"|"data_drift"|"ingestion_watch"|"bi_reliability"|"full_coverage"

  // Monitoring Plan parent (null for standalone groups)
  monitoringPlan   MonitoringPlan? @relation(fields: [monitoringPlanId], references: [id], onDelete: SetNull)
  monitoringPlanId String?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  monitors       Monitor[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([groupType])
  @@index([anchorFqn])
  @@index([watchType])
  @@index([presetGroupId])
  @@index([monitoringPlanId])
}

model MonitoringPlan {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Scope (user intent)
  scopeType    String // "pipeline" | "stream" | "asset" | "tool"
  scopeConfig  Json? // { anchorNodeIds, maxDepth, domainFilters }
  anchorFqn    String?
  anchorNodeId String?

  // Configuration (user intent)
  mode     String // "recommended" | "manual"
  families String[] // selected family keys

  // Aggregate metrics (cached, recomputed after runs)
  totalAssets      Int       @default(0)
  totalMonitors    Int       @default(0)
  coveragePct      Float?
  healthScore      Float?
  healthStatus     String? // "healthy"|"degraded"|"at_risk"|"unhealthy"
  passCount        Int       @default(0)
  warnCount        Int       @default(0)
  failCount        Int       @default(0)
  errorCount       Int       @default(0)
  lastAggregatedAt DateTime?

  // Schedule (plan-level, editing updates all child groups)
  schedule String?
  timezone String? @default("UTC")
  enabled  Boolean @default(true)

  // Alerts (plan-level, editing updates all child groups)
  alertChannels String[]
  alertOnStatus String[]

  // Metadata
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  monitorGroups  MonitorGroup[]

  @@index([organizationId])
  @@index([enabled])
}

// ============================================
// DRIFT RECOMMENDATIONS
// ============================================

model DriftRecommendation {
  id             String @id @default(cuid())
  organizationId String
  monitorId      String
  monitorName    String
  monitorType    String
  targetFqn      String

  driftCategory String
  severity      String

  currentField     String
  currentValue     String
  recommendedValue String

  reasoning  String
  confidence Float
  evidence   Json

  status     String    @default("pending")
  reviewedAt DateTime?

  runId String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  monitor      Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([monitorId])
  @@index([runId])
}
