  @@index([userId])
  @@index([remediationPlanId])
  @@index([status])
  @@index([dueDate])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  GENERAL
  SECURITY_FIX
  CONFIGURATION
  DOCUMENTATION
  REVIEW
  DEPLOYMENT
}

// ============================================
// AI ASSISTANT CHAT
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id])
  userId   String
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  // Context (what the user was looking at)
  contextType String? // "report", "task", "remediation"
  contextId   String?

  // Relations
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  @@index([sessionId])
