# Copy to .env and fill in. Both the Next.js app and the FastAPI backend read
# this file (the backend loads scanner/.env first, then falls back to here).
# Generate secrets with: openssl rand -hex 32

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pallisade
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SCANNER_API_URL=http://127.0.0.1:8000

# At least one LLM provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Security (dev fallbacks exist; all required in production) ──────────────
# Next.js ↔ FastAPI trust boundary — must match on both sides (min 32 bytes)
SCANNER_SHARED_SECRET=
# AES-256-GCM key for stored integration credentials — 64 hex chars
ENCRYPTION_KEY=
INTERNAL_API_KEY=
# Backend → Next.js callbacks (artifacts, clarifications)
INTERNAL_API_SECRET=
SOURCES_VERIFY_HMAC_SECRET=
# Production only: comma-separated origins allowed by the backend
# ALLOWED_ORIGINS=https://app.example.com
# ENVIRONMENT=production

# ── Sign-in providers (optional) ────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── Integration OAuth apps (optional) ───────────────────────────────────────
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Email via Resend (optional — invites, alerts) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Billing via Paystack (optional) ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_GROWTH_PLAN_CODE=
PAYSTACK_BUSINESS_PLAN_CODE=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend tuning (optional) ───────────────────────────────────────────────
# NEXTJS_BASE_URL=http://localhost:3000
# SCHEDULER_INTERVAL_SECONDS=60
# LOG_LEVEL=INFO

# Multi-agent copilot mode — routes SQL/log tasks to specialist models
# COPILOT_MAAS_ENABLED=false
# MAAS_SQL_ENDPOINT=
# MAAS_SQL_API_KEY=
# MAAS_SQL_MODEL=
# MAAS_LOGS_ENDPOINT=
# MAAS_LOGS_API_KEY=
# MAAS_LOGS_MODEL=

# ── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_SOURCES_CATEGORY=false
FEATURE_SOURCES_CATEGORY=false
